# Token dari @BotFather
BOT_TOKEN=123456:your-token-here

# ID Telegram admin, pisahkan dengan koma
ADMIN_IDS=

# Opsional: admin per layanan. Notifikasi layanan tersebut hanya dikirim ke admin ini
# (layanan yang tidak diisi tetap dikirim ke semua ADMIN_IDS).
# ID di sini otomatis dianggap admin.
# LAYANAN_ADMINS=PTKKSS=111,222; TTIS=333; MANRISK=444; PEMDI=555; PENGADUAN=666

# Opsional: inisial admin yang ditambahkan di akhir setiap balasan (mis. "halo -ao").
# Admin yang tidak diisi memakai huruf depan nama Telegram-nya.
# ADMIN_INITIALS=1154578221=ao; 28193590=bs

# Opsional: ID grup Telegram admin (angka negatif, mis. -1001234567890).
# Jika diisi, notifikasi & pesan user yang belum ditangani dikirim ke grup ini.
# ADMIN_GROUP_ID=-1001234567890

# Opsional: satu topik per user di grup admin. Syarat: grup berfitur Topik (Forum),
# bot dijadikan admin grup dengan izin "Manage Topics".
# ADMIN_GROUP_TOPICS=true

# Jam layanan (kosongkan JAM_LAYANAN= untuk layanan 24 jam). Hari: 1=Senin ... 7=Minggu.
# JAM_LAYANAN=08:00-16:00
# HARI_LAYANAN=1-5
# LIBUR=2026-12-25,2026-12-26

# Pengingat permintaan yang belum diambil (0 = nonaktif). Hanya dikirim di jam layanan.
# REMINDER_MINUTES=15
# REMINDER_MAX=3

# Opsional: notifikasi WhatsApp lewat WAHA (https://waha.devlike.pro).
# Aktif bila WAHA_URL dan WA_TARGETS diisi. Di docker-compose, WAHA_URL sudah diatur otomatis;
# isi WAHA_URL sendiri hanya bila bot dijalankan langsung dengan "python bot.py".
# WAHA_URL=http://localhost:3000
# WAHA_API_KEY=ganti-dengan-kunci-acak-yang-panjang
# WAHA_DASHBOARD_USERNAME=admin
# WAHA_DASHBOARD_PASSWORD=ganti-dengan-password-kuat
# WAHA_SESSION=default
# Tujuan: nomor (08xx / 628xx) dan/atau ID grup WhatsApp (xxx@g.us), pisahkan dengan koma.
# WA_TARGETS=081234567890,120363012345678901@g.us
# true = sertakan nama & instansi user di pesan WhatsApp:
# WA_DETAIL=false
# true = kirim juga pengingat tiket yang belum diambil:
# WA_REMINDERS=false

# Opsional (default sudah ada di bot.py)
# BOT_TIMEZONE=Asia/Jakarta
# BOT_WORKERS=4
# CLEANUP_DAYS=30
# Jumlah cadangan harian database di data/backups (0 = nonaktif)
# BACKUP_KEEP=7
# Isi jika koneksi ke api.telegram.org sering timeout / diblokir jaringan kantor
# TELEGRAM_PROXY=http://proxy.kantor:8080
